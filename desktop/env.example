# Copy to %LOCALAPPDATA%\1SHOT Desk\.env. Never commit real values.
GIZMO_BASE_URL=https://YOUR-GIZMO-SERVER/api
GIZMO_LOGIN=YOUR-OPERATOR-LOGIN
GIZMO_PASSWORD=YOUR-OPERATOR-PASSWORD
GIZMO_VERIFY_SSL=true
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
AGENT_SECRET=YOUR-EXISTING-AGENT-SECRET
GUEST_USER_GROUP_ID=3

# Local preview only, after migration/cutover. Takes precedence; no automatic cloud fallback.
# CLUB_API_URL=http://127.0.0.1:8788/api

# Способ оплаты для бесплатного часа по промокоду (товар standart 1 h за 0 ₽). В Gizmo «Наличные» обычно -1
PROMO_PAYMENT_METHOD_ID=-1
# Автоматическая выдача часа по промокоду. Выключено: час выдаёт админ вручную (как обычно, 0% налога в чеке)
# PROMO_AUTO_HOUR=false
# Час продаётся ОТДЕЛЬНОЙ учёткой оператора Gizmo (не GIZMO_LOGIN). Без неё час не выдаётся
# PROMO_GIZMO_LOGIN=YOUR-PROMO-OPERATOR-LOGIN
# PROMO_GIZMO_PASSWORD=YOUR-PROMO-OPERATOR-PASSWORD

# Заказ еды из мини-аппа: приходит на ресепшен как вызов «Сделать заказ». Выключить: FOOD_ENABLED=false
# FOOD_ENABLED=true
# Группы товаров Gizmo, которые не показывать гостям (через запятую). По умолчанию: Standart,VIP,TV,Аренда
# FOOD_HIDE_GROUPS=Standart,VIP,TV,Аренда
